# Default LLM Provider (ollama or lm_studio)
DEFAULT_LLM_PROVIDER=ollama

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=llama3

# V2: Dual-LLM Support
# QUICK_LLM_MODEL=llama3
# DEEP_LLM_MODEL=deepseek-r1

# LM Studio Settings
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_DEFAULT_MODEL=local-model # LM Studio usually ignores this, but langchain requires it
